# Niblit Environment Variables
# Copy this file to .env and fill in the values before running locally.
# On Vercel, set these via the project dashboard under Settings > Environment Variables.

# --- Required ---

# Hugging Face API token for LLM inference
# Obtain from: https://huggingface.co/settings/tokens
# Required for /chat and model-backed endpoints to function
HF_TOKEN=your_huggingface_token_here

# --- Optional ---

# API key to protect /chat and /memory endpoints (leave blank to disable auth)
# If set, all protected requests must include: X-API-Key: <value>
NIBLIT_API_KEY=

# Flask environment (set to "production" on Vercel, "development" locally)
FLASK_ENV=production

# Port used when running locally (Vercel ignores this)
PORT=5000

# --- Vercel Deployment Notes ---
# Memory per function: 768 MB  (set in vercel.json)
# Max function duration: 120 s (set in vercel.json)
# HF model cold-start can take 30-90 s; the 120 s timeout accommodates this.
# Do NOT commit your actual .env file — it is listed in .gitignore.
